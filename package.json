{
  "name": "nd-apps",
  "version": "0.1.0",
  "private": true,
  "description": "Umbrella for ND Property and Fathom Desk",
  "scripts": {
    "dev": "next dev",
    "dev:api": "cd backend && .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8741",
