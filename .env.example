# Auth.js (NextAuth v5) — Google, nataliedennis.co.uk only
# Generate AUTH_SECRET with: openssl rand -base64 32
# Keep AUTH_SECRET stable — changing it invalidates every signed-in session.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Local: http://localhost:3000
# Production: https://vercel-github-poc.vercel.app
AUTH_URL=http://localhost:3000
# Required on Vercel so Auth.js trusts X-Forwarded-Host
AUTH_TRUST_HOST=true

# PROPERTYDATA_API_KEY=
# Optional. Deal appraisal works without it.
# Research lookups call api.propertydata.co.uk via /api/pd/* and spend credits.

# Local browser only. Ignored when VERCEL is set or NODE_ENV is production,
# including every Vercel build. Do not set this on the Vercel project.
# AUTH_DEV_BYPASS=1

# Optional local override for the Fathom API proxy used by `next dev`.
# Default is http://127.0.0.1:8741. Leave unset on Vercel: vercel.json routes
# /fathom/api, /fathom/Monitoring, /fathom/docs, and /fathom/openapi.json to
# the Python service. API_PROXY_URL is accepted as an alias.
# FATHOM_API_URL=http://127.0.0.1:8741
